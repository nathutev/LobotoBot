{
  "manifest_version": 3,
  "name": "LobotoBot",
  "version": "2.0",
  "description": "🐝",
  "content_scripts": [
    {
      "matches": [
        "*://*.wocabee.app/app/student/*"
      ],
      "js": [
        "app.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
